# bu dosyayı .env olarak kopyalayıp kendi ortamınıza göre düzenleyin.
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=Eskiz1DB
DB_TRUSTED_CONNECTION=true
# DB_TRUSTED_CONNECTION=false kullanılıyorsa aşağıdakiler de doldurulmalı:
# DB_USER=
# DB_PASSWORD=

API_HOST=127.0.0.1
API_PORT=8000
